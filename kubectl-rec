#!/usr/bin/env bash
# =============================================================================
# kubectl-rec  —  state-changing kubectl 操作のローカル履歴記録器
# -----------------------------------------------------------------------------
# 対応サブコマンド: apply / delete / replace / patch
#
# 想定される起動経路 (どれでも動く):
#   1) シェル関数経由 (透過):   kubectl apply -f foo.yaml
#        → kubectl-rec.sh の kubectl() が `command kubectl-rec apply -f foo.yaml` を呼ぶ
#   2) kubectl plugin として:   kubectl rec apply -f foo.yaml
#   3) 直接:                    kubectl-rec apply -f foo.yaml
#
# 出力 (KUBECTL_HISTORY_DIR で上書き可):
#   ~/.kube/kubectl-history/
#     ├── history.jsonl                                   1 操作 = 1 行
#     └── snapshots/<timestamp>-<sha12>-<filename>        -f / -k で渡された実体
#
# 依存: bash 3.2+, jq 1.5+, kubectl, (sha256sum | shasum)
# WSL Ubuntu bash で動作確認済み
# =============================================================================

# set -euo pipefail / set -u を使わない
# bash と zsh の挙動差・WSL固有の制限を避けるため、
# エラーチェックはすべて明示的に行う

# ---------- Configuration ---------------------------------------------------
HISTORY_DIR="${KUBECTL_HISTORY_DIR:-$HOME/.kube/kubectl-history}"
INDEX_FILE="$HISTORY_DIR/history.jsonl"
SNAPSHOT_DIR="$HISTORY_DIR/snapshots"
KUBECTL_BIN="${KUBECTL_BIN:-kubectl}"

# HISTORY_DIR / SNAPSHOT_DIR を最初に作成
if ! mkdir -p "$SNAPSHOT_DIR"; then
  echo "[kubectl-rec] ERROR: cannot create $SNAPSHOT_DIR" >&2
  exit 1
fi

# ---------- Helpers ---------------------------------------------------------
die()  { echo "[kubectl-rec] ERROR: $*" >&2; exit 1; }
warn() { echo "[kubectl-rec] WARN: $*"  >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

have jq             || die "jq is required (apt-get install jq / brew install jq)"
have "$KUBECTL_BIN" || die "$KUBECTL_BIN not found in PATH"

# WSL: Windows の find.exe / sort.exe が PATH に混入することがあるため
# Linux の /usr/bin 版を明示的に使う
FIND_CMD="/usr/bin/find"
SORT_CMD="/usr/bin/sort"
[ -x "$FIND_CMD" ] || FIND_CMD="$(command -v find 2>/dev/null)"
[ -x "$SORT_CMD" ] || SORT_CMD="$(command -v sort 2>/dev/null)"

sha256_of() {
  if have sha256sum; then
    sha256sum "$1" 2>/dev/null | awk '{print $1}'
  elif have shasum; then
    shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'
  else
    printf ''
  fi
}

abspath() {
  case "$1" in
    -|http://*|https://*) printf '%s' "$1"; return ;;
  esac
  if have realpath; then
    realpath --canonicalize-missing "$1" 2>/dev/null || printf '%s' "$1"
  elif have python3; then
    python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$1" 2>/dev/null \
      || printf '%s' "$1"
  else
    ( cd "$(dirname "$1")" 2>/dev/null \
      && printf '%s/%s' "$(pwd)" "$(basename "$1")" ) || printf '%s' "$1"
  fi
}

# ファイル内容を JSON 文字列値に変換
# jq --rawfile (1.6+) に頼らず python3 / jq -Rs で処理
file_to_json_str() {
  local _p="$1"
  if have python3; then
    python3 -c '
import sys, json
try:
    data = open(sys.argv[1], "r", errors="replace").read()
except Exception:
    data = ""
sys.stdout.write(json.dumps(data))
' "$_p" 2>/dev/null || printf '""'
  else
    jq -Rs '.' < "$_p" 2>/dev/null || printf '""'
  fi
}

# JSON 配列に source エントリを追加 (pipe 使用、herestring 不使用)
append_source() {
  local _json="$1" _type="$2" _input="$3" _path="$4" _sha="$5" _snap="$6"
  printf '%s' "$_json" | jq -c \
    --arg type  "$_type"  \
    --arg input "$_input" \
    --arg path  "$_path"  \
    --arg sha   "$_sha"   \
    --arg snap  "$_snap"  \
    '. + [{type:$type,input:$input,path:$path,sha256:$sha,snapshot:$snap}]' \
    2>/dev/null || printf '%s' "$_json"
}

iso_now()   { date "+%Y-%m-%dT%H:%M:%S%z" 2>/dev/null || date -u "+%Y-%m-%dT%H:%M:%SZ"; }
stamp_now() { date "+%Y%m%dT%H%M%S"; }

# ---------- Detect operation ------------------------------------------------
OP=""
_skip=0
for _a in "$@"; do
  if [ "$_skip" = "1" ]; then _skip=0; continue; fi
  case "$_a" in
    --kubeconfig|--context|-n|--namespace|--cluster|--user|--server|--token|\
--certificate-authority|--client-key|--client-certificate|--as|--as-group|-s)
      _skip=1 ;;
    -*) ;;
    *)
      case "$_a" in
        apply|delete|replace|patch)
          OP="$_a"; break ;;
        *)
          die "unsupported operation: '$_a' (supported: apply/delete/replace/patch)" ;;
      esac ;;
  esac
done
[ -z "$OP" ] && die "no supported operation found in args"

# ---------- Parse -f / -k / -R from argv ------------------------------------
declare -a F_VALUES=()
declare -a K_VALUES=()
RECURSIVE=0
DRY_RUN=""
declare -a PASSTHRU=("$@")

_n="${#PASSTHRU[@]}"
_i=0
while [ "$_i" -lt "$_n" ]; do
  _a="${PASSTHRU[$_i]}"
  _j=$(( _i + 1 ))
  case "$_a" in
    -f|--filename)
      if [ "$_j" -lt "$_n" ]; then F_VALUES+=("${PASSTHRU[$_j]}"); fi
      _i=$(( _i + 2 )) ;;
    -f=*|--filename=*)
      F_VALUES+=("${_a#*=}"); _i=$(( _i + 1 )) ;;
    -k|--kustomize)
      if [ "$_j" -lt "$_n" ]; then K_VALUES+=("${PASSTHRU[$_j]}"); fi
      _i=$(( _i + 2 )) ;;
    -k=*|--kustomize=*)
      K_VALUES+=("${_a#*=}"); _i=$(( _i + 1 )) ;;
    -R|--recursive)
      RECURSIVE=1; _i=$(( _i + 1 )) ;;
    --dry-run)
      if [ "$_j" -lt "$_n" ]; then DRY_RUN="${PASSTHRU[$_j]}"; fi
      _i=$(( _i + 2 )) ;;
    --dry-run=*)
      DRY_RUN="${_a#*=}"; _i=$(( _i + 1 )) ;;
    *)
      _i=$(( _i + 1 )) ;;
  esac
done

# ---------- Handle stdin (-f -) ---------------------------------------------
STDIN_SNAPSHOT=""
_pi=0
while [ "$_pi" -lt "$_n" ]; do
  if [ "${PASSTHRU[$_pi]}" = "-" ] && [ "$_pi" -gt 0 ]; then
    _prev="${PASSTHRU[$(( _pi - 1 ))]}"
    if [ "$_prev" = "-f" ] || [ "$_prev" = "--filename" ]; then
      STDIN_SNAPSHOT="$(mktemp "$SNAPSHOT_DIR/.stdin.XXXXXX.yaml" 2>/dev/null)" \
        || STDIN_SNAPSHOT="$(mktemp)"
      cat > "$STDIN_SNAPSHOT"
      PASSTHRU[$_pi]="$STDIN_SNAPSHOT"
      _fi=0
      while [ "$_fi" -lt "${#F_VALUES[@]}" ]; do
        if [ "${F_VALUES[$_fi]}" = "-" ]; then F_VALUES[$_fi]="$STDIN_SNAPSHOT"; fi
        _fi=$(( _fi + 1 ))
      done
      break
    fi
  fi
  _pi=$(( _pi + 1 ))
done

# ---------- Resolve -f/-k → tmpfile (プロセス置換を使わない WSL 互換) -------
_SOURCES_TMP="$(mktemp)"

{
  _fi=0
  while [ "$_fi" -lt "${#F_VALUES[@]}" ]; do
    _spec="${F_VALUES[$_fi]}"
    _fi=$(( _fi + 1 ))
    [ -z "$_spec" ] && continue
    case "$_spec" in
      http://*|https://*)
        printf 'url|%s|%s\n' "$_spec" "$_spec" ;;
      *)
        if [ -d "$_spec" ]; then
          if [ "$RECURSIVE" = "1" ]; then
            "$FIND_CMD" "$_spec" -type f \
              \( -name '*.yaml' -o -name '*.yml' -o -name '*.json' \) \
              2>/dev/null | "$SORT_CMD" | while IFS= read -r _f; do
              printf 'file|%s|%s\n' "$_spec" "$(abspath "$_f")"
            done
          else
            "$FIND_CMD" "$_spec" -maxdepth 1 -type f \
              \( -name '*.yaml' -o -name '*.yml' -o -name '*.json' \) \
              2>/dev/null | "$SORT_CMD" | while IFS= read -r _f; do
              printf 'file|%s|%s\n' "$_spec" "$(abspath "$_f")"
            done
          fi
        elif [ -f "$_spec" ]; then
          printf 'file|%s|%s\n' "$_spec" "$(abspath "$_spec")"
        else
          printf 'missing|%s|%s\n' "$_spec" "$_spec"
        fi ;;
    esac
  done

  _ki=0
  while [ "$_ki" -lt "${#K_VALUES[@]}" ]; do
    _spec="${K_VALUES[$_ki]}"
    _ki=$(( _ki + 1 ))
    [ -z "$_spec" ] && continue
    printf 'kustomize|%s|%s\n' "$_spec" "$(abspath "$_spec")"
  done
} > "$_SOURCES_TMP"

# ---------- Snapshot + build sources JSON -----------------------------------
_TS="$(stamp_now)"
SOURCES_JSON='[]'

while IFS='|' read -r _stype _sinput _sabsp; do
  [ -z "$_stype" ] && continue
  _snap="" _sha=""

  case "$_stype" in
    file)
      if [ -f "$_sabsp" ]; then
        _sha="$(sha256_of "$_sabsp")"
        _snap="$SNAPSHOT_DIR/${_TS}-${_sha:0:12}-$(basename "$_sabsp")"
        if [ ! -f "$_snap" ]; then
          cp "$_sabsp" "$_snap" 2>/dev/null || _snap=""
        fi
      fi ;;
    kustomize)
      if [ -d "$_sabsp" ]; then
        _snap="$SNAPSHOT_DIR/${_TS}-kustomize-$(basename "$_sabsp").yaml"
        if "$KUBECTL_BIN" kustomize "$_sabsp" > "$_snap" 2>/dev/null; then
          _sha="$(sha256_of "$_snap")"
        else
          rm -f "$_snap"; _snap=""
        fi
      fi ;;
    url|missing) ;;
  esac

  SOURCES_JSON="$(append_source "$SOURCES_JSON" "$_stype" "$_sinput" "$_sabsp" "$_sha" "$_snap")"
done < "$_SOURCES_TMP"
rm -f "$_SOURCES_TMP"

# ---------- Run actual kubectl ----------------------------------------------
STDOUT_TMP="$(mktemp)"
STDERR_TMP="$(mktemp)"

_cleanup() {
  [ -n "$STDIN_SNAPSHOT" ] && rm -f "$STDIN_SNAPSHOT"
  rm -f "$STDOUT_TMP" "$STDERR_TMP"
}
trap _cleanup EXIT

"$KUBECTL_BIN" "${PASSTHRU[@]}" > "$STDOUT_TMP" 2> "$STDERR_TMP"
EXIT_CODE=$?

cat "$STDOUT_TMP"
cat "$STDERR_TMP" >&2

# ---------- Capture context info --------------------------------------------
CTX="$("$KUBECTL_BIN" config current-context 2>/dev/null)" || CTX=""
CLUSTER="$("$KUBECTL_BIN" config view --minify -o "jsonpath={.clusters[0].name}" 2>/dev/null)" || CLUSTER=""
NS="$("$KUBECTL_BIN" config view --minify -o "jsonpath={..namespace}" 2>/dev/null)" || NS=""
[ -z "$NS" ] && NS="default"

# ---------- stdout/stderr を JSON 文字列に変換 ------------------------------
STDOUT_JSON="$(file_to_json_str "$STDOUT_TMP")"
STDERR_JSON="$(file_to_json_str "$STDERR_TMP")"

# ---------- コマンド配列を JSON 配列に変換 ----------------------------------
CMD_JSON="[]"
if have python3; then
  _CMD_TMP="$(mktemp)"
  printf '%s\0' "$KUBECTL_BIN" "${PASSTHRU[@]}" > "$_CMD_TMP"
  CMD_JSON="$(python3 -c '
import sys, json
raw = open(sys.argv[1], "rb").read()
args = [a.decode("utf-8", errors="replace") for a in raw.split(b"\x00") if a]
print(json.dumps(args))
' "$_CMD_TMP" 2>/dev/null)" || CMD_JSON="[]"
  rm -f "$_CMD_TMP"
else
  # python3 がない場合: jq で一つずつ追加
  for _item in "$KUBECTL_BIN" "${PASSTHRU[@]}"; do
    CMD_JSON="$(printf '%s' "$CMD_JSON" \
      | jq -c --arg v "$_item" '. + [$v]' 2>/dev/null)" || true
  done
fi

# ---------- Append history entry --------------------------------------------
_USER="${USER:-}"
[ -z "$_USER" ] && _USER="$(id -un 2>/dev/null)" || true
[ -z "$_USER" ] && _USER="unknown"
_HOST="$(hostname 2>/dev/null)" || _HOST="unknown"

jq -cn \
  --arg ts        "$(iso_now)"  \
  --arg op        "$OP"         \
  --arg user      "$_USER"      \
  --arg host      "$_HOST"      \
  --arg cwd       "$(pwd)"      \
  --arg context   "$CTX"        \
  --arg cluster   "$CLUSTER"    \
  --arg namespace "$NS"         \
  --arg dry_run   "$DRY_RUN"    \
  --argjson exit    "$EXIT_CODE"    \
  --argjson sources "$SOURCES_JSON" \
  --argjson command "$CMD_JSON"     \
  --argjson stdout  "$STDOUT_JSON"  \
  --argjson stderr  "$STDERR_JSON"  \
  '{
    timestamp:  $ts,
    operation:  $op,
    user:       $user,
    host:       $host,
    cwd:        $cwd,
    context:    $context,
    cluster:    $cluster,
    namespace:  $namespace,
    dry_run:    $dry_run,
    command:    $command,
    sources:    $sources,
    exit_code:  $exit,
    stdout:     $stdout,
    stderr:     $stderr
  }' >> "$INDEX_FILE" \
  || warn "failed to write history entry to $INDEX_FILE"

exit "$EXIT_CODE"
